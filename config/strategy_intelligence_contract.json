{
  "contract_version": "AFIP-W3-STRATEGY-1.0",
  "authority": "ADVISORY_ONLY",
  "input_authority": "W2_CONTEXT_EVIDENCE",
  "output": "STRATEGY_CANDIDATE_RANKING",
  "final_decision_authority": false,
  "execution_authority": false,
  "order_send_allowed": false,
  "lot_authority": false,
  "sl_tp_authority": false,
  "profile_independent": true,
  "minimum_advisory_score_for_plan_review": 80.0,
  "minimum_hierarchical_research_score": 80.0,
  "research_plan_gate": {
    "enabled_for_configured_profiles": true,
    "required_current_context": ["regime", "trend_state", "structure_state", "zone_position", "pattern_family", "pattern_name"],
    "required_matching_evidence": ["pattern_name", "pattern_family", "market_regime", "structure_state", "zone_position", "rank", "sample_size"],
    "fail_closed_when_context_or_exact_evidence_is_missing": true,
    "execution_authority": "NONE"
  },
  "hierarchical_research": {
    "required_scopes": ["PATTERN_FAMILY", "EXACT_NAMED_SHAPE"],
    "shape_dimensions": [
      "candle_count",
      "duration_seconds",
      "average_body_ratio",
      "upper_wick_ratio",
      "lower_wick_ratio",
      "pullback_depth_atr",
      "total_range_atr",
      "slope_strength"
    ],
    "advisory_weights": {
      "family_research": 0.30,
      "exact_shape_research": 0.40,
      "shape_similarity": 0.30
    },
    "fail_closed_when_missing_or_low": true
  },
  "fail_closed": true,
  "forbidden_outputs": [
    "BUY_ORDER",
    "SELL_ORDER",
    "LOT_SIZE",
    "FINAL_SL",
    "FINAL_TP",
    "MT5_REQUEST"
  ]
}
